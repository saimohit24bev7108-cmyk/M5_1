{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M5 Circuit Schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "Schema version. Major version must be 1."
    },
    "qubits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "description": "Number of qubits in the circuit."
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gate": {
            "type": "string",
            "enum": ["I", "X", "Y", "Z", "H", "S", "T", "CNOT"]
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueItems": true
          }
        },
        "required": ["gate", "targets"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": { "gate": { "const": "CNOT" } }
            },
            "then": {
              "properties": {
                "targets": { "minItems": 2, "maxItems": 2 }
              }
            },
            "else": {
              "properties": {
                "targets": { "minItems": 1, "maxItems": 1 }
              }
            }
          }
        ]
      }
    }
  },
  "required": ["version", "qubits", "operations"],
  "additionalProperties": false
}
