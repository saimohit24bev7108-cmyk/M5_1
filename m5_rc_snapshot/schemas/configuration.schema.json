{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M5 Configuration Schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "mode": {
      "type": "string",
      "enum": ["ideal", "noisy"]
    },
    "shots": {
      "type": "integer",
      "minimum": 1
    },
    "seed": {
      "type": ["integer", "null"]
    },
    "noise_config": {
      "type": "object"
    }
  },
  "required": ["version", "mode", "shots", "seed"],
  "additionalProperties": false
}
